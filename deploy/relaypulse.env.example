RELAYPULSE_LISTEN_ADDR=127.0.0.1:8080
RELAYPULSE_DATA_DIR=/var/lib/relaypulse
RELAYPULSE_LOG_LEVEL=info
RELAYPULSE_SHUTDOWN_TIMEOUT=10s

RELAYPULSE_PUBLIC_URL=https://watchbot.cfd
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=

# Generate outside Git: 32 random bytes encoded with unpadded base64url.
RELAYPULSE_SESSION_ENCRYPTION_KEY=

# Optional loopback-only challenge provider.
RELAYPULSE_FLARESOLVERR_ENDPOINT=http://127.0.0.1:8191
