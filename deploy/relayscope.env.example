RELAYSCOPE_LISTEN_ADDR=127.0.0.1:8080
RELAYSCOPE_DATA_DIR=/var/lib/relayscope
RELAYSCOPE_LOG_LEVEL=info
RELAYSCOPE_SHUTDOWN_TIMEOUT=10s

RELAYSCOPE_PUBLIC_URL=https://relayscope.example.com
RELAYSCOPE_OAUTH_CLIENT_ID=
RELAYSCOPE_OAUTH_CLIENT_SECRET=

# LINUX DO Credit（易支付兼容协议）：配置后开启 LDC 直充会员与许愿助力。
# 通知地址填 https://<域名>/api/v1/payment/notify，回跳地址填 https://<域名>/api/v1/payment/return
RELAYSCOPE_PAY_GATEWAY=https://credit.linux.do/epay
RELAYSCOPE_PAY_PID=
RELAYSCOPE_PAY_KEY=

# Generate outside Git: 32 random bytes encoded with unpadded base64url.
RELAYSCOPE_SESSION_ENCRYPTION_KEY=

# Optional loopback-only challenge provider.
RELAYSCOPE_FLARESOLVERR_ENDPOINT=http://127.0.0.1:8191
RELAYSCOPE_HTTP_CONCURRENCY=3
RELAYSCOPE_COLLECTION_TIMEOUT=3m
RELAYSCOPE_HTTP_TIMEOUT=20s
RELAYSCOPE_MAINTENANCE_INTERVAL=30m
