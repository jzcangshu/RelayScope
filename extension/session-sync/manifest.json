{
  "manifest_version": 3,
  "name": "RelayPulse 访问令牌同步",
  "version": "0.5.0",
  "description": "仅将待更新站点的访问令牌同步到 RelayPulse。",
  "permissions": ["scripting", "sidePanel", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "打开 RelayPulse 访问令牌同步"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
